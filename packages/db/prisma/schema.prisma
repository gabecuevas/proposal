enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum WebhookDeliveryStatus {
  PENDING
  RETRYING
  SUCCESS
