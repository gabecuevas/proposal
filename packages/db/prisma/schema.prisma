enum CrmEmailFolder {
  INBOX
  DRAFTS
  OUTBOX
  SENT
  TRASH
}

enum CrmEmailDirection {
  INBOUND
  OUTBOUND
}

enum CrmEmailSyncProvider {
  GOOGLE
  OFFICE365
  EXCHANGE
  IMAP
}

enum CrmEmailSyncStatus {
  INACTIVE
  ACTIVE
  ERROR
}

model CrmEmailAccount {
  id                      String               @id @default(cuid())
  workspace_id            String
  user_id                 String?
  provider                CrmEmailSyncProvider @default(GOOGLE)
  email                   String
  sender_name             String?
  is_default              Boolean              @default(false)
  sync_status             CrmEmailSyncStatus   @default(INACTIVE)
  sync_from_at            DateTime?
  last_synced_at          DateTime?
  imap_host               String?
  imap_port               Int?
  smtp_host               String?
  smtp_port               Int?
  credentials_configured  Boolean              @default(false)
  oauth_access_token      String?
  oauth_refresh_token     String?
  oauth_expires_at        DateTime?
  oauth_scope             String?
  created_at              DateTime             @default(now())
  updated_at              DateTime             @updatedAt

  workspace Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  messages  CrmEmailMessage[]
  signatures CrmEmailSignature[]

  @@unique([workspace_id, email])
  @@index([workspace_id, sync_status])
}

model CrmEmailMessage {
  id               String            @id @default(cuid())
  workspace_id     String
  account_id       String?
  folder           CrmEmailFolder    @default(INBOX)
  direction        CrmEmailDirection
  from_name        String?
  from_address     String
  to_addresses     Json
  cc_addresses     Json?
  subject          String            @default("")
  snippet          String            @default("")
  body_text        String?
  body_html        String?
  is_read          Boolean           @default(false)
  has_attachments  Boolean           @default(false)
  message_at       DateTime          @default(now())
  external_id      String?
  contact_id       String?
  lead_id          String?
  company_id       String?
  pinned_at        DateTime?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt

  workspace Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  account   CrmEmailAccount? @relation(fields: [account_id], references: [id], onDelete: SetNull)
  contact   Contact?         @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  lead      Lead?            @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  company   Company?         @relation(fields: [company_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, folder, message_at])
  @@index([workspace_id, is_read, folder])
  @@index([contact_id, message_at])
  @@index([lead_id, message_at])
  @@index([company_id, message_at])
  @@index([workspace_id, pinned_at])
  @@unique([workspace_id, external_id])
}

enum CrmEmailTemplateVisibility {
  PRIVATE
  SHARED
}

model CrmEmailTemplate {
  id           String                     @id @default(cuid())
  workspace_id String
  user_id      String?
  name         String
  subject      String                     @default("")
  body_html    String                     @default("")
  visibility   CrmEmailTemplateVisibility @default(PRIVATE)
  created_at   DateTime                   @default(now())
  updated_at   DateTime                   @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, updated_at])
  @@index([workspace_id, name])
}

model CrmEmailSignature {
  id           String   @id @default(cuid())
  workspace_id String
  user_id      String?
  account_id   String?
  name         String
  body_html    String   @default("")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)
  account   CrmEmailAccount? @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, updated_at])
  @@index([account_id, updated_at])
}

enum CrmCalendarSyncProvider {
  GOOGLE
}

enum CrmCalendarSyncStatus {
  INACTIVE
  ACTIVE
  ERROR
}

model CrmCalendarAccount {
  id                     String                   @id @default(cuid())
  workspace_id           String
  user_id                String
  provider               CrmCalendarSyncProvider  @default(GOOGLE)
  email                  String
  calendar_id            String                   @default("primary")
  calendar_name          String?
  sync_status            CrmCalendarSyncStatus    @default(INACTIVE)
  last_synced_at         DateTime?
  sync_token             String?
  event_color            String                   @default("#7C3AED")
  oauth_access_token     String?
  oauth_refresh_token    String?
  oauth_expires_at       DateTime?
  oauth_scope            String?
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt

  workspace Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events    CrmCalendarEvent[]

  @@unique([workspace_id, user_id, provider])
  @@index([workspace_id, sync_status])
}

model CrmCalendarEvent {
  id           String   @id @default(cuid())
  workspace_id String
  account_id   String
  external_id  String
  calendar_id  String   @default("primary")
  title        String   @default("(no title)")
  description  String?
  location     String?
  html_link    String?
  status       String?
  all_day      Boolean  @default(false)
  starts_at    DateTime
  ends_at      DateTime
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  account   CrmCalendarAccount @relation(fields: [account_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, external_id])
  @@index([workspace_id, starts_at])
  @@index([account_id, starts_at])
}

// --- Platform support module ---

model ActivitySession {
  id           String   @id @default(cuid())
  user_id      String
  workspace_id String?
  started_at   DateTime @default(now())
  last_seen_at DateTime @default(now())
  ended_at     DateTime?
  created_at   DateTime @default(now())

  user      User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  @@index([user_id, started_at])
  @@index([user_id, last_seen_at])
  @@index([workspace_id, started_at])
}

enum SupportConversationStatus {
  OPEN
  WAITING_ON_CUSTOMER
  RESOLVED
}

enum SupportConversationPriority {
  NORMAL
  HIGH
}

enum SupportMessageSource {
  IN_APP
  EMAIL
  SYSTEM
}

enum SupportMessageVisibility {
  PUBLIC
  INTERNAL
}

model SupportConversation {
  id                 String                     @id @default(cuid())
  customer_user_id   String
  workspace_id       String?
  subject            String
  status             SupportConversationStatus  @default(OPEN)
  priority           SupportConversationPriority @default(NORMAL)
  assignee_admin_id  String?
  source             String                     @default("messenger")
  campaign_delivery_id String?
  last_message_at    DateTime                   @default(now())
  last_public_preview String?
  customer_unread_count Int                     @default(0)
  admin_unread_count Int                        @default(0)
  created_at         DateTime                   @default(now())
  updated_at         DateTime                   @updatedAt

  customer  User            @relation("support_conversation_customer", fields: [customer_user_id], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspace_id], references: [id], onDelete: SetNull)
  messages  SupportMessage[]
  readStates SupportReadState[]
  replyTokens SupportReplyToken[]
  emailDeliveries SupportEmailDelivery[]

  @@index([status, last_message_at])
  @@index([assignee_admin_id, status, last_message_at])
  @@index([customer_user_id, last_message_at])
  @@index([workspace_id, last_message_at])
}

model SupportMessage {
  id              String                   @id @default(cuid())
  conversation_id String
  sender_user_id  String?
  visibility      SupportMessageVisibility @default(PUBLIC)
  source          SupportMessageSource     @default(IN_APP)
  body_html       String
  body_text       String
  client_op_id    String?
  sequence        Int
  email_message_id String?
  provider_email_id String?
  delivery_status String?
  created_at      DateTime                 @default(now())

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User?               @relation("support_message_sender", fields: [sender_user_id], references: [id], onDelete: SetNull)

  @@unique([conversation_id, sequence])
  @@unique([sender_user_id, client_op_id])
  @@index([conversation_id, created_at])
  @@index([provider_email_id])
}

model SupportReadState {
  id                    String   @id @default(cuid())
  conversation_id       String
  user_id               String
  last_read_sequence    Int      @default(0)
  updated_at            DateTime @updatedAt

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([conversation_id, user_id])
}

model SupportContactNote {
  id               String   @id @default(cuid())
  subject_user_id  String
  author_admin_id  String
  body             String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  subject User @relation("support_note_subject", fields: [subject_user_id], references: [id], onDelete: Cascade)
  author  User @relation("support_note_author", fields: [author_admin_id], references: [id], onDelete: Cascade)

  @@index([subject_user_id, created_at])
}

model SupportReplyToken {
  id              String    @id @default(cuid())
  conversation_id String
  recipient_user_id String
  token_hash      String    @unique
  revoked_at      DateTime?
  created_at      DateTime  @default(now())

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, recipient_user_id])
}

model SupportEmailDelivery {
  id              String   @id @default(cuid())
  conversation_id String
  message_id      String?
  to_email        String
  provider_id     String?
  status          String   @default("queued")
  scheduled_at    DateTime @default(now())
  sent_at         DateTime?
  last_error      String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  conversation SupportConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([status, scheduled_at])
  @@index([conversation_id, created_at])
}

model SupportJob {
  id              String    @id @default(cuid())
  type            String
  payload_json    Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  lease_expires_at DateTime?
  run_after       DateTime  @default(now())
  last_error      String?
  idempotency_key String?   @unique
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([status, run_after])
}

model SupportAuditEvent {
  id           String   @id @default(cuid())
  actor_user_id String?
  action       String
  target_type  String?
  target_id    String?
  metadata_json Json?
  created_at   DateTime @default(now())

  @@index([action, created_at])
  @@index([actor_user_id, created_at])
}

/// Admin "sudo" sessions. No FKs so the record survives user deletion.
model SupportImpersonationSession {
  id             String    @id @default(cuid())
  admin_user_id  String
  admin_email    String
  target_user_id String
  target_email   String
  started_at     DateTime  @default(now())
  expires_at     DateTime
  ended_at       DateTime?
  ended_reason   String?
  request_count  Int       @default(0)

  @@index([admin_user_id, started_at])
  @@index([target_user_id, started_at])
}

model SavedAudience {
  id           String   @id @default(cuid())
  name         String
  filters_json Json
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

enum InAppCampaignStatus {
  DRAFT
  SCHEDULED
  LIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model InAppCampaign {
  id              String              @id @default(cuid())
  title           String
  status          InAppCampaignStatus @default(DRAFT)
  sender_user_id  String?
  body_html       String
  body_text       String
  cta_label       String?
  cta_url         String?
  filters_json    Json
  delivery_mode   String              @default("ongoing")
  starts_at       DateTime?
  ends_at         DateTime?
  published_version Int               @default(1)
  snapshot_json   Json?
  created_by      String
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  deliveries CampaignDelivery[]

  @@index([status, starts_at])
}

model CampaignDelivery {
  id              String    @id @default(cuid())
  campaign_id     String
  user_id         String
  workspace_id    String?
  campaign_version Int      @default(1)
  delivered_at    DateTime  @default(now())
  viewed_at       DateTime?
  clicked_at      DateTime?
  replied_at      DateTime?
  conversation_id String?

  campaign  InAppCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspace_id], references: [id], onDelete: SetNull)

  @@unique([campaign_id, user_id, campaign_version])
  @@index([user_id, delivered_at])
  @@index([campaign_id, delivered_at])
}

model InboundEmailEvent {
  id              String   @id @default(cuid())
  provider_event_id String @unique
  provider_email_id String?
  status          String   @default("received")
  raw_meta_json   Json?
  created_at      DateTime @default(now())
  processed_at    DateTime?
  last_error      String?

  @@index([status, created_at])
}
