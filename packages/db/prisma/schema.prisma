generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  owner_user_id String?
  audit_retention_days Int @default(90)
  audit_export_token_ttl_minutes Int @default(15)
  cpq_approval_discount_threshold Int @default(15)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  templates     Template[]
  templateFolders TemplateFolder[]
  documents     Document[]
  contentBlocks ContentBlock[]
  contentBlockFolders ContentBlockFolder[]
  activityEvents DocumentActivityEvent[]
  auditExportLedgers AuditExportLedger[]
  apiKeys       ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  documentPayments DocumentPayment[]
  quoteApprovals QuoteApprovalRequest[]
  members       WorkspaceMember[]
  invites       WorkspaceInvite[]
  contacts      Contact[]
  companies     Company[]
  leads         Lead[]
  crmActivities CrmActivity[]
  crmTimelineEvents CrmTimelineEvent[]
  sentVersions  DocumentSentVersion[]
  owner         User?            @relation("workspace_owner", fields: [owner_user_id], references: [id], onDelete: SetNull)
}

model TemplateFolder {
  id             String   @id @default(cuid())
  workspace_id   String
  parent_id      String?
  name           String
  created_by     String
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  parent    TemplateFolder?  @relation("FolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children  TemplateFolder[] @relation("FolderTree")
  templates Template[]
  shares    TemplateFolderShare[]

  @@index([workspace_id, parent_id])
}

model TemplateFolderShare {
  id           String   @id @default(cuid())
  folder_id    String
  user_id      String
  role         String   @default("viewer")
  created_at   DateTime @default(now())

  folder TemplateFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, user_id])
  @@index([user_id])
}

model Template {
  id             String   @id @default(cuid())
  workspace_id   String
  folder_id      String?
  name           String
  tags           Json
  variable_registry_json Json?
  pricing_json    Json?
  editor_json    Json
  schema_version Int      @default(1)
  created_by     String
  updated_by     String?
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  folder    TemplateFolder? @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  documents Document[]
  shares    TemplateShare[]

  @@index([workspace_id, folder_id])
}

model TemplateShare {
  id           String   @id @default(cuid())
  template_id  String
  user_id      String
  role         String   @default("viewer")
  created_at   DateTime @default(now())

  template Template @relation(fields: [template_id], references: [id], onDelete: Cascade)

  @@unique([template_id, user_id])
  @@index([user_id])
}

model Document {
  id                String         @id @default(cuid())
  workspace_id      String
  template_id       String?
  contact_id        String?
  editor_json       Json
  schema_version    Int            @default(1)
  doc_version       Int            @default(1)
  status            DocumentStatus @default(DRAFTED)
  variables_json    Json
  pricing_json      Json
  recipients_json   Json
  finalized_pdf_key String?
  doc_hash          String?
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  workspace       Workspace        @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  template        Template?        @relation(fields: [template_id], references: [id], onDelete: SetNull)
  contact         Contact?         @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  recipients      Recipient[]
  signatureFields SignatureField[]
  activityEvents  DocumentActivityEvent[]
  webhookDeliveries WebhookDelivery[]
  payments      DocumentPayment[]
  quoteApprovals QuoteApprovalRequest[]
  sentVersions  DocumentSentVersion[]
}

model DocumentPayment {
  id                  String                 @id @default(cuid())
  workspace_id        String
  document_id         String
  provider            PaymentProvider
  provider_session_id String                 @unique
  status              DocumentPaymentStatus  @default(PENDING)
  amount_minor        Int
  currency            String
  checkout_url        String?
  paid_at             DateTime?
  metadata_json       Json
  created_at          DateTime               @default(now())
  updated_at          DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, status, created_at])
  @@index([document_id, created_at])
}

model QuoteApprovalRequest {
  id                    String              @id @default(cuid())
  workspace_id          String
  document_id           String
  status                QuoteApprovalStatus @default(PENDING)
  requested_by_user_id  String
  requested_reason      String?
  decided_by_user_id    String?
  decided_reason        String?
  discount_percent      Float
  threshold_percent     Float
  created_at            DateTime            @default(now())
  decided_at            DateTime?

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, created_at])
  @@index([document_id, created_at])
}

model DocumentSentVersion {
  id                       String   @id @default(cuid())
  document_id              String
  workspace_id             String
  version_number           Int
  editor_json              Json
  pricing_json             Json
  variables_json           Json
  resolved_variables_json  Json
  recipients_json          Json
  schema_version           Int      @default(1)
  snapshot_hash            String
  snapshot_kind            String   @default("send")
  created_by_user_id       String
  created_at               DateTime @default(now())
  sent_at                  DateTime

  document  Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@unique([document_id, version_number])
  @@index([document_id, sent_at])
  @@index([workspace_id, created_at])
}

model ContentBlockFolder {
  id           String   @id @default(cuid())
  workspace_id String
  parent_id    String?
  name         String
  created_by   String
  updated_at   DateTime @updatedAt
  created_at   DateTime @default(now())

  workspace Workspace            @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  parent    ContentBlockFolder?  @relation("ContentBlockFolderTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children  ContentBlockFolder[] @relation("ContentBlockFolderTree")
  blocks    ContentBlock[]
  shares    ContentBlockFolderShare[]

  @@index([workspace_id, parent_id])
}

model ContentBlockFolderShare {
  id         String   @id @default(cuid())
  folder_id  String
  user_id    String
  role       String   @default("viewer")
  created_at DateTime @default(now())

  folder ContentBlockFolder @relation(fields: [folder_id], references: [id], onDelete: Cascade)

  @@unique([folder_id, user_id])
  @@index([user_id])
}

model ContentBlock {
  id             String   @id @default(cuid())
  workspace_id   String
  folder_id      String?
  name           String
  block_type     String
  editor_json    Json
  version        Int      @default(1)
  schema_version Int      @default(1)
  created_by     String?
  updated_by     String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  folder    ContentBlockFolder? @relation(fields: [folder_id], references: [id], onDelete: SetNull)
  shares    ContentBlockShare[]

  @@index([workspace_id, folder_id])
}

model ContentBlockShare {
  id         String   @id @default(cuid())
  block_id   String
  user_id    String
  role       String   @default("viewer")
  created_at DateTime @default(now())

  block ContentBlock @relation(fields: [block_id], references: [id], onDelete: Cascade)

  @@unique([block_id, user_id])
  @@index([user_id])
}

model Recipient {
  id            String        @id @default(cuid())
  document_id   String
  email         String
  name          String
  role          RecipientRole
  signing_order Int
  group_key     String?
  created_at    DateTime      @default(now())

  document        Document         @relation(fields: [document_id], references: [id], onDelete: Cascade)
  signatureFields SignatureField[]
}

model SignatureField {
  id              String     @id @default(cuid())
  document_id     String
  recipient_id    String
  field_type      FieldType
  position_json   Json
  required        Boolean    @default(true)
  value_json      Json?
  signed_at       DateTime?
  audit_meta_json Json?
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  document  Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)
  recipient Recipient @relation(fields: [recipient_id], references: [id], onDelete: Cascade)
}

model User {
  id                     String            @id @default(cuid())
  email                  String            @unique
  name                   String
  password_hash          String
  default_workspace_id   String?
  created_at             DateTime          @default(now())
  updated_at             DateTime          @updatedAt
  workspace_memberships  WorkspaceMember[]
  owned_workspaces       Workspace[]       @relation("workspace_owner")
  owned_contacts         Contact[]         @relation("contact_owner")
  owned_companies        Company[]         @relation("company_owner")
  owned_leads            Lead[]            @relation("lead_owner")
  crm_activities_created  CrmActivity[]  @relation("crm_activity_creator")
  crm_activities_assigned CrmActivity[]   @relation("crm_activity_assignee")
  crm_timeline_events    CrmTimelineEvent[]
}

model Contact {
  id                String   @id @default(cuid())
  workspace_id      String
  owner_user_id     String?
  first_name        String
  last_name         String
  full_name         String
  email             String
  phone             String?
  company_name      String?
  title             String?
  address_line_1    String?
  address_line_2    String?
  city              String?
  state             String?
  postal_code       String?
  country           String?
  website           String?
  notes             String?
  custom_fields_json Json?
  tags              Json
  color_label       String?
  last_activity_at  DateTime?
  company_id        String?
  source            String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  owner     User?     @relation("contact_owner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)
  documents Document[]
  leads     Lead[]
  crmActivities CrmActivity[]
  crmTimelineEvents CrmTimelineEvent[]

  @@index([workspace_id, updated_at])
  @@index([workspace_id, full_name])
  @@index([workspace_id, email])
  @@index([workspace_id, company_id])
}

model Company {
  id             String   @id @default(cuid())
  workspace_id   String
  owner_user_id  String?
  name           String
  website        String?
  phone          String?
  email          String?
  address_line_1 String?
  address_line_2 String?
  city           String?
  state          String?
  postal_code    String?
  country        String?
  industry       String?
  notes          String?
  tags           Json
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  owner     User?     @relation("company_owner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  people    Contact[]
  leads     Lead[]
  crmActivities CrmActivity[]
  crmTimelineEvents CrmTimelineEvent[]

  @@index([workspace_id, updated_at])
  @@index([workspace_id, name])
}

model Lead {
  id                 String     @id @default(cuid())
  workspace_id       String
  owner_user_id      String?
  title              String
  status             LeadStatus @default(NEW)
  source             String?
  value_minor        Int?
  currency           String     @default("USD")
  person_id          String?
  company_id         String?
  first_name         String?
  last_name          String?
  full_name          String?
  email              String?
  phone              String?
  company_name       String?
  contact_title      String?
  address_line_1     String?
  address_line_2     String?
  city               String?
  state              String?
  postal_code        String?
  country            String?
  website            String?
  notes              String?
  custom_fields_json Json?
  tags               Json       @default("[]")
  color_label        String?
  last_activity_at   DateTime?
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  owner     User?     @relation("lead_owner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  person    Contact?  @relation(fields: [person_id], references: [id], onDelete: SetNull)
  company   Company?  @relation(fields: [company_id], references: [id], onDelete: SetNull)
  crmActivities CrmActivity[]
  crmTimelineEvents CrmTimelineEvent[]

  @@index([workspace_id, updated_at])
  @@index([workspace_id, status])
}

enum CrmActivityType {
  CALL
  MEETING
  TASK
  DEADLINE
  EMAIL
  LUNCH
}

enum CrmActivityPriority {
  LOW
  MEDIUM
  HIGH
}

enum CrmActivityAvailability {
  FREE
  BUSY
}

enum CrmTimelineEventType {
  RECORD_CREATED
  FIELD_CHANGED
  NOTE_SAVED
  ACTIVITY_CREATED
  ACTIVITY_UPDATED
  ACTIVITY_COMPLETED
  ACTIVITY_DELETED
}

model CrmActivity {
  id                 String                  @id @default(cuid())
  workspace_id       String
  created_by_user_id String
  assignee_user_id   String?
  contact_id         String?
  lead_id            String?
  company_id         String?
  activity_type      CrmActivityType
  subject            String
  description        String?
  location           String?
  video_call_url     String?
  notes              String?
  priority           CrmActivityPriority?
  availability       CrmActivityAvailability @default(FREE)
  due_at             DateTime?
  end_at             DateTime?
  completed_at       DateTime?
  created_at         DateTime                @default(now())
  updated_at         DateTime                @updatedAt

  workspace  Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  created_by User      @relation("crm_activity_creator", fields: [created_by_user_id], references: [id], onDelete: Cascade)
  assignee   User?     @relation("crm_activity_assignee", fields: [assignee_user_id], references: [id], onDelete: SetNull)
  contact    Contact?  @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  company    Company?  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  timelineEvents CrmTimelineEvent[]

  @@index([workspace_id, due_at])
  @@index([workspace_id, assignee_user_id, due_at])
  @@index([contact_id, due_at])
  @@index([lead_id, due_at])
  @@index([company_id, due_at])
}

model CrmTimelineEvent {
  id              String               @id @default(cuid())
  workspace_id    String
  actor_user_id   String?
  contact_id      String?
  lead_id         String?
  company_id      String?
  activity_id     String?
  event_type      CrmTimelineEventType
  field_key       String?
  field_label     String?
  old_value       String?
  new_value       String?
  summary         String
  created_at      DateTime             @default(now())

  workspace Workspace    @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  actor     User?        @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)
  contact   Contact?     @relation(fields: [contact_id], references: [id], onDelete: Cascade)
  lead      Lead?        @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  company   Company?     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  activity  CrmActivity? @relation(fields: [activity_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([contact_id, created_at])
  @@index([lead_id, created_at])
  @@index([company_id, created_at])
}

model WorkspaceMember {
  id           String        @id @default(cuid())
  workspace_id String
  user_id      String
  role         WorkspaceRole
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([workspace_id, user_id])
}

model WorkspaceInvite {
  id             String        @id @default(cuid())
  workspace_id   String
  email          String
  role           WorkspaceRole
  invite_token   String        @unique
  invited_by     String
  accepted_at    DateTime?
  expires_at     DateTime
  created_at     DateTime      @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
}

model DocumentActivityEvent {
  id                 String   @id @default(cuid())
  workspace_id       String
  document_id        String
  event_type         String
  actor_user_id      String?
  actor_recipient_id String?
  metadata_json      Json
  created_at         DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  document  Document  @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@index([document_id, created_at])
  @@index([workspace_id, created_at])
}

model ApiKey {
  id           String        @id @default(cuid())
  workspace_id String
  name         String
  key_prefix   String
  key_hash     String        @unique
  role         WorkspaceRole @default(MEMBER)
  created_by   String
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, revoked_at])
  @@index([workspace_id, revoked_at, expires_at])
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  workspace_id String
  url          String
  secret       String
  events_json  Json
  allowed_ips_json Json?
  require_mtls Boolean @default(false)
  mtls_cert_fingerprint String?
  is_active    Boolean  @default(true)
  created_by   String
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspace_id, is_active])
}

model AuditExportLedger {
  id                  String   @id @default(cuid())
  workspace_id        String
  actor_user_id       String
  export_type         String
  before_at           DateTime?
  export_limit        Int
  row_count           Int
  checksum            String
  previous_entry_hash String?
  entry_hash          String
  metadata_json       Json
  created_at          DateTime @default(now())

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  @@index([workspace_id, created_at])
}

model WebhookDelivery {
  id              String                @id @default(cuid())
  workspace_id    String
  endpoint_id     String
  document_id     String?
  event_type      String
  status          WebhookDeliveryStatus @default(PENDING)
  attempts        Int                   @default(0)
  payload_json    Json
  signature       String?
  http_status     Int?
  response_body   String?
  next_retry_at   DateTime?
  delivered_at    DateTime?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt

  workspace Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpoint_id], references: [id], onDelete: Cascade)
  document  Document?       @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, status, created_at])
  @@index([endpoint_id, created_at])
}

enum DocumentStatus {
  DRAFTED
  SENT
  VIEWED
  COMMENTED
  SIGNED
  PAID
  EXPIRED
  VOID
}

enum RecipientRole {
  SIGNER
  APPROVER
  VIEWER
}

enum FieldType {
  SIGNATURE
  INITIALS
  DATE
  TEXT
  CHECKBOX
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum WebhookDeliveryStatus {
  PENDING
  RETRYING
  SUCCESS
  DEAD_LETTER
}

enum QuoteApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  STRIPE
}

enum DocumentPaymentStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}
